# Amul Parlour Environment Configuration

# Frontend API Base URL (empty or localhost:5000 in development / production backend)
# When left empty, the application runs in Local-First Mode using IndexedDB.
VITE_API_BASE_URL=""

# Backend Cloud SQL & PostgreSQL Configuration (Used when connecting to shared backend)
SQL_HOST="127.0.0.1"
SQL_USER="amul_app_user"
SQL_PASSWORD="your_secure_password"
SQL_DB_NAME="amul_parlour_db"
SQL_PORT=5432

# Admin migration user (used by backend drizzle-kit / migrations)
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="your_admin_password"

# Application URL and Gemini Key (automatically provided in AI Studio)
APP_URL="MY_APP_URL"
GEMINI_API_KEY="MY_GEMINI_API_KEY"
